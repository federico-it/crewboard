# Local development. Docker Compose exposes PostgreSQL on loopback only.
# In Coolify use a private database hostname and strong password, not these local values.
DATABASE_URL=postgresql://crewboard:crewboard_local_only@127.0.0.1:54329/crewboard
BETTER_AUTH_URL=http://127.0.0.1:3100
# Generate: openssl rand -hex 32. Runtime only; never NEXT_PUBLIC_ or build args.
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# CLI seed only. Enable exclusively for a synthetic demo database.
DEMO_SEED_ENABLED=false
DEMO_PASSWORD=REPLACE_WITH_A_DEMO_PASSWORD_AT_LEAST_12_CHARACTERS
# TEST_BASE_URL=http://127.0.0.1:3104

# Future Cloudflare R2 integration: not consumed yet. Bucket must remain private.
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_BUCKET=crewboard-demo
# R2_ACCESS_KEY_ID=REPLACE_ME
# R2_SECRET_ACCESS_KEY=REPLACE_ME
