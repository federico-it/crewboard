# Current WebMCP spike: no application environment variables are required.
# There is no database, authentication or storage integration yet.
# Copying/uncommenting these examples does NOT connect those services.
# Docker already sets NODE_ENV, PORT and HOSTNAME; no .env is needed to deploy.

# Planned MVP configuration, to be wired and validated during implementation.
# Keep credentials server-side; never use NEXT_PUBLIC_ for these values.
# Set real secrets in Coolify runtime variables, not Git or Docker build args.

# PostgreSQL: use the private hostname reachable from the application container.
# DATABASE_URL=postgresql://crewboard:REPLACE_ME@DB_INTERNAL_HOST:5432/crewboard

# Cloudflare R2: private bucket, S3-compatible endpoint from its dashboard.
# Use bucket-scoped S3 Access Key ID / Secret Access Key, not a generic API token.
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_BUCKET=crewboard-demo
# R2_ACCESS_KEY_ID=REPLACE_ME
# R2_SECRET_ACCESS_KEY=REPLACE_ME

# Authentication variables will be added with the actual auth implementation.
